<mvc:View
  controllerName="codeql.sap.bindcontext.controller.app"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc">
  <VBox>
    <Input id="payloadInput" value="{/customer/name}" />
    <VBox id="customerDetails">
      <core:HTML id="htmlSink" content="{name}" />
      <core:HTML id="namedSink" content="{named>name}" />
      <VBox id="otherDetails">
        <core:HTML id="nestedSink" content="{name}" />
      </VBox>
      <VBox id="relativeDetails">
        <core:HTML id="relativeContextSink" content="{name}" />
      </VBox>
      <List items="{/otherList}">
        <CustomListItem>
          <core:HTML id="aggregationSink" content="{name}" />
        </CustomListItem>
      </List>
      <List items="{orders}">
        <CustomListItem>
          <core:HTML id="relativeAggregationSink" content="{name}" />
        </CustomListItem>
      </List>
      <VBox id="localModelDetails">
        <Input id="localModelInput" value="{/customer/name}" />
        <core:HTML id="localModelSink" content="{name}" />
      </VBox>
      <VBox id="overrideModelBoundary">
        <VBox id="overrideRelativeDetails">
          <core:HTML id="overrideRelativeSink" content="{name}" />
        </VBox>
      </VBox>
      <List items="{/groups}">
        <CustomListItem>
          <VBox id="groupRelativeDetails">
            <core:HTML id="groupRelativeSink" content="{name}" />
          </VBox>
        </CustomListItem>
      </List>
    </VBox>
    <VBox id="trailingSlashDetails">
      <core:HTML id="trailingSlashSink" content="{name}" />
    </VBox>
    <VBox id="legacyDetails">
      <core:HTML id="legacySink" content="{name}" />
    </VBox>
    <VBox id="objectDetails">
      <core:HTML id="objectSink" content="{name}" />
    </VBox>
    <VBox id="namedObjectDetails">
      <core:HTML id="namedObjectSink" content="{name}" />
    </VBox>
    <VBox id="namedPathDetails">
      <core:HTML id="namedPathSink" content="{name}" />
    </VBox>
    <core:HTML id="globalReferenceSink" content="{name}" />
    <core:HTML id="siblingSink" content="{name}" />
  </VBox>
</mvc:View>
