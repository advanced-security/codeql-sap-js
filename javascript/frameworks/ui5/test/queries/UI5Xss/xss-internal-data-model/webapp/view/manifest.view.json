{
	"Type": "sap.ui.core.mvc.JSONView",
	"controllerName": "codeql-sap-js.controller.app",
	"content": [
		{
			"Type": "sap.m.Input",
			"value": "{/manifest}"
		},
		{
			"Type": "sap.ui.core.HTML",
			"content": "{/manifest}"
		},
		{
			"Type": "sap.m.List",
			"items": {
				"path": "/nested",
				"template": {
					"Type": "sap.m.CustomListItem",
					"content": [
						{
							"Type": "sap.m.Input",
							"value": "{value}"
						},
						{
							"Type": "sap.ui.core.HTML",
							"content": "{value}"
						}
					]
				}
			}
		}
	]
}
