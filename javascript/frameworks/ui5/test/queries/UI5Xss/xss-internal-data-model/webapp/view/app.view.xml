<mvc:View
  controllerName="codeql-sap-js.controller.app"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:mvc="sap.ui.core.mvc">
  <Button id="localModelControl" />
  <List items="{/items}">
    <CustomListItem>
      <Input value="{value}" />
      <core:HTML content="{value}" />
    </CustomListItem>
  </List>
  <mvc:XMLView viewName="codeql-sap-js.view.local" />
</mvc:View>
