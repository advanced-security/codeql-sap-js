{
  "_version": "2.0.0",
  "sap.app": {
    "id": "codeql-sap-js",
    "type": "application",
    "title": "UI5 inferred JSON model",
    "dataSources": {
      "modelData": {
        "uri": "model/data.json",
        "type": "JSON"
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "rootView": {
      "viewName": "codeql-sap-js.view.app",
      "type": "XML",
      "id": "app"
    },
    "models": {
      "": {
        "dataSource": "modelData"
      }
    }
  }
}
