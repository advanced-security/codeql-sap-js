{
  "Type": "sap.ui.core.mvc.JSONView",
  "content": [
    {
      "Type": "sap.m.List",
      "items": {
        "path": "/groups",
        "template": {
          "Type": "sap.m.CustomListItem",
          "content": [
            {
              "Type": "sap.m.List",
              "items": {
                "path": "entries",
                "template": {
                  "Type": "sap.m.CustomListItem",
                  "content": [
                    {
                      "Type": "sap.m.Input",
                      "value": "{value}"
                    },
                    {
                      "Type": "sap.ui.core.HTML",
                      "content": "{value}"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}
